# --- verschluesselter Datensatz ---
KEY_DERIVATION: HKDF-SHA256( shared_secret_bytes )  info=kapitel-02-dh-aead-v1
SHARED_SECRET_ENCODING: big-endian, Laenge = ceil(bits(p)/8) Bytes
RECORD_CIPHER: AES-256-GCM
