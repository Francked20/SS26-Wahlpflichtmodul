DOMAIN=app.localhost
API_DOMAIN=api.localhost
SCR_DOMAIN=scr.localhost
CHALLENGE_DOMAIN=challenge.localhost
HEADING=Dummy CTF
SUB_HEADING=B-CY Wahlpflichtmodul Projekt
PAGE_TITLE=Dummy CTF
SCOREBOARD_TITLE=Dummy CTF Event - Scoreboard

#Used for Auth Emails
BRANDING=CTF@TCV Event

# Set to True to enable production mode
SET_PRODUCTION_MODE=False

# define multiple absolute paths by splitting with `:`
CTF_WEBSITE_FOLDER=/custom/sites/pages

# set to skip syncing challenges to db
# CTF_SKIP_SYNC_CHALLENGES=true

# monitor blocking tasks (only in dev mode!)
CTF_MONITOR_LOOP=False

MONGO_DB=ctf_database

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=this-is-a-very-strong-admin-password

ADMIN_SECRET=this-is-a-super-secure-admin-token
CHALLENGE_API_KEY=this-is-a-very-special-api-key

# Training VM for the day-4 weak-DH (Logjam) live capture (see
# custom/challengebackend/endpoints/dh_export.py's start_capture and
# CTF_Utils/dh_export_vm_listener.py). Leave empty until that VM exists -
# the endpoint falls back to "service not configured" gracefully.
DH_EXPORT_VM_HOST=
DH_EXPORT_VM_PORT=

# Change to INFO for production!
LOG_LEVEL=DEBUG

# For SSL
SMTP_SSL_PORT=465
# TODO: This is not given! Please use manual DB user entry files instead
SMTP_SSL_PASSWORD=this-is-not-given-please-use-manual-DB-user-entry-files-instead
SMTP_SSL_USERNAME=ctf@th-deg.de
SMTP_SSL_SERVER=smtp.th-deg.de
SMTP_SSL_SENDER_EMAIL=ctf@th-deg.de

# TODO: Use "generate_JWT_SECRET.py for your secret
JWT_SECRET=86ba061665834be38cd1e76d42adce68431de2b806e194c0cac272bb0cb14d2bc71363a5ac2b22a4272aaaf43a883997e3534746ed4257420b3ce36c3346b73c4ea8b6c9aa13bf88ea92ea815a63a7044ea37cf290363a4c9cb287d7d666582d5571b79e3501d29bc7b4c085ab69ce3c37efccc9a0323e60424dc468f0d9b1ae

# Day 3 "export cipher" (FREAK-style) challenge: where the training VM is that
# receives each player's on-demand mock TLS traffic (triggered by their
# "Gestartet" button). Leave unset to disable start_capture (503 response).
EXPORT_CIPHER_VM_HOST=192.168.178.99
EXPORT_CIPHER_VM_PORT=4433
