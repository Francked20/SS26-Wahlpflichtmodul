# ---- Builder Stage ----
FROM ghcr.io/astral-sh/uv:python3.13-alpine AS builder

# Set working directory
WORKDIR /app

# Install build-time dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    linux-headers \
    bash \
    util-linux \
    curl

# Create and activate virtual environment
RUN uv venv .venv
ENV VIRTUAL_ENV=/app/.venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Install Python dependencies with cache busting
COPY requirements.txt ./
RUN uv pip install --no-cache-dir -r requirements.txt

# Patch Reflex Source Code to disable Branding
RUN sed -i "/if is_prod_mode() and config.show_built_with_reflex:/,+1d" /app/.venv/lib/python*/site-packages/reflex/app.py

# Initialize Reflex and build frontend assets
RUN reflex init

# Copy application source
COPY ./core/site/ .

# Copy the custom content
COPY ./custom/assets/ ./assets/
COPY ./custom/sites/ ./web/sites/
COPY ./custom/tasks/ ./web/tasks/
COPY ./custom/task_conf.py ./web/site_engine/task_conf.py


# Graceful shutdown
STOPSIGNAL SIGTERM

# Disable Next.js Telemetry https://nextjs.org/telemetry
ENV NEXT_TELEMETRY_DISABLED=1
ENV LOGLEVEL=debug

# Define a Healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD curl -f http://localhost:8000/ping/ || exit 1 

# Default command: run migrations then start server
CMD ["sh", "-c", "reflex db migrate && reflex run --env prod --loglevel debug"]
